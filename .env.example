SOURCE_SHEET_ID=<your-source-google-sheet-id>
DEST_SHEET_ID=<your-agent2-preprocessed-google-sheet-id>
EXPLORATION_SHEET_ID=<your-agent3-exploration-google-sheet-id>
# Option A (Recommended — no Google Cloud required): Google Apps Script Web App bridge
# APPS_SCRIPT_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
# APPS_SCRIPT_TOKEN=<your-secret-token>
# Option B: Google Cloud Service Account JSON key (path or raw JSON string)
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
